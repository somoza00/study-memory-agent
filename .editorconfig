# EditorConfig: padroniza estilo-base entre editores/IDEs (backend Python 4
# espaços; frontend TS/YAML/JSON 2 espaços). Referência apenas.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2